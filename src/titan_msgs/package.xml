<?xml-model
href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"
?>
<package format="3">
<!--
 Package name — must match the folder name and CMakeLists project() 
-->
<name>titan_msgs</name>
<version>0.1.0</version>
<description>
Custom ROS 2 message and service types for the Titan DMS project. Includes LoRa frame messages, platoon state, health score, etc.
</description>
<!-- Who maintains this package -->
<maintainer email="student@nitw.ac.in">Student</maintainer>
<license>MIT</license>
<!--
 Build tool — ament_cmake is the standard for CMake-based ROS 2 packages 
-->
<buildtool_depend>ament_cmake</buildtool_depend>
<!--
 These two are required for any package that defines .msg or .srv files:
       - rosidl_default_generators: compiles .msg files into Python + C++ code at BUILD time
       - rosidl_default_runtime: lets other packages import those messages at RUN time 
-->
<buildtool_depend>rosidl_default_generators</buildtool_depend>
<exec_depend>rosidl_default_runtime</exec_depend>
<!--
 This tag tells colcon that this package belongs to the rosidl group,
       which means it generates message/service interfaces 
-->
<member_of_group>rosidl_interface_packages</member_of_group>
<!--
 Standard message types we might reference in our custom messages
       (e.g., std_msgs/Header for timestamps, geometry_msgs/Pose for positions) 
-->
<depend>std_msgs</depend>
<depend>geometry_msgs</depend>
<depend>sensor_msgs</depend>
<export>
<build_type>ament_cmake</build_type>
</export>
</package>